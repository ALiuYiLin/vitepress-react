{
  "name": "@10coding/mdx-kernel",
  "version": "0.1.0",
  "description": "MDX 内核:把文档 Markdown 编译为可渲染 React 模块并采集 PageData(frontmatter/headers/title)。自研件:PageData 契约;生态件:remark-attributes/remark-math/rehype-katex/remark-gfm 等",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "smoke": "vite-node --mode=production scripts/smoke-attrs.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-attributes": "^0.4.4",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
