{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // IDE(vscode 等)默认按根 tsconfig 解析 src 下文件;缺 jsx 会让所有 .tsx
    // 退回 preserve,在 React 19 类型下报出大量 intrinsic/JSX 错误。
    // CLI typecheck 各自走 tsconfig.{client,node,shared}.json(见 package.json)。
    "jsx": "react-jsx",
    "paths": {
      "@10coding/vitepress-react": ["./src/client/index.ts"],
      "@10coding/vitepress-react/theme": ["./types/default-theme.d.ts"],
      "@siteData": ["./src/client/shims.d.ts"],
      "@theme/index": ["./src/client/shims.d.ts"],
      "@localSearchIndex": ["./src/client/shims.d.ts"]
    }
  },
  "include": [
    "src",
    "types",
    "scripts",
    "shared-globals.d.ts",
    "tsdown.config.ts"
  ]
}
